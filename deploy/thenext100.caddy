# Appended to /etc/caddy/Caddyfile by deploy.ps1 -FirstTime. Same pattern as acl26 / ajntrip / indianrummy.
thenext100.duckdns.org {
	root * /srv/thenext100/site
	encode gzip
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header / Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
	log {
		output file /var/log/caddy/thenext100.log
	}
}
