{
  "name": "the-next-100",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A living, self-updating forecast of the next 100 years of humanity.",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "validate": "tsx scripts/validate.ts",
    "checkin:brief": "tsx scripts/checkin-brief.ts",
    "checkin:log": "tsx scripts/checkin-log.ts"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
